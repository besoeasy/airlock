#!/usr/bin/env bash
set -e

VERSION="dev"
PROJECT_URL="https://github.com/besoeasy/airlock"
GITHUB_REPO="besoeasy/airlock"
RELEASE_API_URL="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"

# Latest released version via GitHub Releases API (no jq dependency).
# Prints e.g. "2026.09.16" or "unavailable" (offline, rate-limited, no releases yet).
# To avoid hammering the API (menu header runs on every render, unauthenticated
# limit is 60 req/hr), the network check runs on ~20% of invocations; otherwise
# the local version is returned (i.e. "assume current, no update notice").
get_latest_version() {
    local api_json tag
    if [ $((RANDOM % 100)) -ge 20 ]; then
        echo "$VERSION"
        return 0
    fi
    if command -v curl >/dev/null 2>&1; then
        api_json=$(curl -fsSL --connect-timeout 2 --max-time 5 "$RELEASE_API_URL" 2>/dev/null) || { echo "unavailable"; return 0; }
    elif command -v wget >/dev/null 2>&1; then
        api_json=$(wget -qO- --connect-timeout=2 --timeout=5 "$RELEASE_API_URL" 2>/dev/null) || { echo "unavailable"; return 0; }
    else
        echo "unavailable"
        return 0
    fi
    tag=$(printf '%s' "$api_json" | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v?([^"]+)".*/\1/')
    tag=$(printf '%s' "$tag" | tr -d '[:space:]')
    if [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        echo "$tag"
    else
        echo "unavailable"
    fi
}

# Returns 0 if version $1 is newer than version $2 (numeric per-component).
# Non-numeric suffixes are ignored ("1.2-rc1" compares as "1.2").
# Supports CalVer with a same-day counter (2026.09.16.1).
version_greater() {
    local a="${1#v}" b="${2#v}" i ai bi
    local IFS=.
    local a_parts=($a) b_parts=($b)
    for i in 0 1 2 3; do
        ai="${a_parts[$i]:-0}"; bi="${b_parts[$i]:-0}"
        ai="${ai%%[^0-9]*}"; bi="${bi%%[^0-9]*}"
        ai="${ai:-0}"; bi="${bi:-0}"
        if [ "$ai" -gt "$bi" ] 2>/dev/null; then return 0; fi
        if [ "$ai" -lt "$bi" ] 2>/dev/null; then return 1; fi
    done
    return 1
}

# Canonical runtimes + accepted aliases (single source for help, init, completions).
RUNTIMES_ALL="aider alpine arch archlinux bun c cpp gcc debian deno fedora go kali kalilinux nix node opencode php python ruby rust semgrep trivy ubuntu zig"

is_known_runtime() {
    case "$1" in
        aider|alpine|arch|archlinux|bun|c|cpp|gcc|debian|deno|fedora|go|kali|kalilinux|nix|node|opencode|php|python|ruby|rust|semgrep|trivy|ubuntu|zig)
            return 0 ;;
        *) return 1 ;;
    esac
}

show_version() {
    local latest_version
    latest_version=$(get_latest_version)

    echo "Airlock version: $VERSION"
    echo "Latest release: $latest_version"
    # Only release-stamped copies (installed via install.sh) get an update
    # verdict; dev checkouts and manual copies just report what they are.
    if [[ "$VERSION" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]] && [ "$latest_version" != "unavailable" ] && version_greater "$latest_version" "$VERSION"; then
        echo "Update available: $latest_version (re-run install.sh to update)"
    fi
    if is_selinux_enabled; then
        echo "SELinux: enabled (:z flag active)"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        echo "User mapping: $AIRLOCK_USER"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            echo "Config: .airlock (runtime: $CFG_RUNTIME)"
        else
            echo "Config: .airlock"
        fi
    fi
}

ensure_path() {
    local bin_dir="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
        export PATH="$bin_dir:$PATH"
    fi
}

is_selinux_enabled() {
    if [ "${AIRLOCK_SELINUX:-}" = "0" ] || [ "${AIRLOCK_SELINUX:-}" = "false" ]; then
        return 1
    fi
    if [ "${AIRLOCK_SELINUX:-}" = "1" ] || [ "${AIRLOCK_SELINUX:-}" = "true" ]; then
        return 0
    fi
    if command -v selinuxenabled >/dev/null 2>&1; then
        selinuxenabled
    elif [ -f /sys/fs/selinux/enforce ]; then
        return 0
    else
        return 1
    fi
}

detect_runtime() {
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        echo "Error: container engine required. Install Podman (recommended) or Docker." >&2
        exit 1
    fi
}

CFG_FOUND=false
CFG_RUNTIME=""
CFG_PORTS=""
CFG_NETWORK=""
CFG_USER=""
CFG_SELINUX=""
declare -a CFG_ENVS=()

load_airlock_config() {
    local config_file="${PWD}/.airlock"
    [ -f "$config_file" ] || return 0
    CFG_FOUND=true

    while IFS= read -r line || [ -n "$line" ]; do
        # Trim leading and trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [ -z "$line" ] && continue
        [[ "$line" == \#* ]] && continue

        if [[ "$line" == *"="* ]]; then
            local key="${line%%=*}"
            local val="${line#*=}"

            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            key="$(echo "$key" | tr '[:upper:]' '[:lower:]')"

            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            case "$val" in
                \"*\") val="${val#\"}"; val="${val%\"}" ;;
                \'*\') val="${val#\'}"; val="${val%\'}" ;;
            esac

            case "$key" in
                runtime)
                    CFG_RUNTIME="$val"
                    ;;
                ports|port)
                    CFG_PORTS="$val"
                    ;;
                network|net)
                    CFG_NETWORK="$val"
                    ;;
                user)
                    CFG_USER="$val"
                    ;;
                selinux)
                    CFG_SELINUX="$val"
                    ;;
                env)
                    CFG_ENVS+=("$val")
                    ;;
            esac
        else
            if [ -z "$CFG_RUNTIME" ]; then
                CFG_RUNTIME="$line"
            fi
        fi
    done < "$config_file"

    if [ -n "$CFG_RUNTIME" ]; then
        CFG_RUNTIME="$(printf '%s' "$CFG_RUNTIME" | tr '[:upper:]' '[:lower:]')"
    fi
    if [ -n "$CFG_SELINUX" ] && [ -z "${AIRLOCK_SELINUX:-}" ]; then
        AIRLOCK_SELINUX="$CFG_SELINUX"
    fi
    if [ -n "$CFG_USER" ] && [ -z "${AIRLOCK_USER:-}" ]; then
        AIRLOCK_USER="$CFG_USER"
    fi
}

is_valid_port() {
    [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Populates the NET_ARGS array (declared by the caller, launch()).
# Never build these as an interpolated string: unquoted expansion of a
# plain string lets a space-containing value smuggle extra flags (e.g.
# network=host --privileged) into the container runtime invocation.
get_network_args() {
    NET_ARGS=()

    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_PORTS" ]; then
            if [ -n "$CFG_NETWORK" ]; then
                echo "Warning: .airlock sets both ports and network; ports take precedence (network ignored)" >&2
            fi
            local p
            for p in $CFG_PORTS; do
                is_valid_port "$p" || { echo "Invalid .airlock ports entry: '$p' (expected a number 1-65535)" >&2; exit 1; }
                NET_ARGS+=(-p "$p:$p")
            done
        elif [ -n "$CFG_NETWORK" ]; then
            [[ "$CFG_NETWORK" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "Invalid .airlock network entry: '$CFG_NETWORK' (expected a simple name like host, bridge, none)" >&2; exit 1; }
            NET_ARGS=(--network "$CFG_NETWORK")
        else
            NET_ARGS=(--network host)
        fi
        return
    fi

    local ports
    if ! read -rp "Ports to open (space-separated, e.g. 3000 8080) or Enter for --network host: " ports; then
        echo "(no input detected — using --network host)" >&2
        ports=""
    fi

    if [ -z "$ports" ]; then
        NET_ARGS=(--network host)
    else
        local p
        for p in $ports; do
            is_valid_port "$p" || { echo "Invalid port: '$p' (expected a number 1-65535)" >&2; exit 1; }
            NET_ARGS+=(-p "$p:$p")
        done
    fi
}

launch() {
    local name="$1"
    local rt
    rt=$(detect_runtime)
    local -a NET_ARGS
    get_network_args

    local vol_mount="${PWD}:/workspace"
    if is_selinux_enabled; then
        vol_mount="${vol_mount}:z"
    fi

    local -a user_args=()
    if [ -n "${AIRLOCK_USER:-}" ]; then
        if [ "$AIRLOCK_USER" != "0" ] && [ "$AIRLOCK_USER" != "root" ]; then
            user_args=(--user "$AIRLOCK_USER" -e HOME=/tmp)
        fi
    elif [ "$rt" = "docker" ] && [ "$(id -u)" -ne 0 ]; then
        user_args=(--user "$(id -u):$(id -g)" -e HOME=/tmp)
    fi

    local -a image_args
    case "$name" in
        aider)
            image_args=(
                -e OPENAI_API_KEY -e ANTHROPIC_API_KEY -e GEMINI_API_KEY -e OPENROUTER_API_KEY -e DEEPSEEK_API_KEY
                docker.io/paulgauthier/aider
            )
            ;;
        alpine)
            image_args=(docker.io/library/alpine:latest sh)
            ;;
        archlinux|arch)
            image_args=(docker.io/library/archlinux:latest bash)
            ;;
        bun)
            image_args=(docker.io/oven/bun:latest bash)
            ;;
        c|cpp|gcc)
            image_args=(docker.io/library/gcc:latest bash)
            ;;
        debian)
            image_args=(docker.io/library/debian:stable bash)
            ;;
        deno)
            image_args=(--entrypoint /bin/bash docker.io/denoland/deno:latest)
            ;;
        fedora)
            image_args=(docker.io/library/fedora:latest bash)
            ;;
        go)
            image_args=(docker.io/library/golang:latest bash)
            ;;
        kali|kalilinux)
            image_args=(docker.io/kalilinux/kali-rolling:latest bash)
            ;;
        nix)
            image_args=(docker.io/nixos/nix:latest sh)
            ;;
        node)
            image_args=(docker.io/library/node:lts bash)
            ;;
        opencode)
            image_args=(ghcr.io/anomalyco/opencode)
            ;;
        php)
            image_args=(docker.io/library/php:cli bash)
            ;;
        python)
            image_args=(docker.io/library/python:3 bash)
            ;;
        ruby)
            image_args=(docker.io/library/ruby:latest bash)
            ;;
        rust)
            image_args=(docker.io/library/rust:latest bash)
            ;;
        trivy|semgrep)
            image_args=(docker.io/aquasec/trivy:latest fs /workspace)
            ;;
        ubuntu)
            image_args=(docker.io/library/ubuntu:latest bash)
            ;;
        zig)
            image_args=(--entrypoint /bin/sh docker.io/euantorano/zig:latest)
            ;;
        *)
            echo "Unknown runtime: $name" >&2
            echo "Runtimes: $RUNTIMES_ALL" >&2
            exit 1
            ;;
    esac

    local -a env_args=()
    if [ "${#CFG_ENVS[@]}" -gt 0 ]; then
        for env_item in "${CFG_ENVS[@]}"; do
            env_args+=(-e "$env_item")
        done
    fi

    $rt run -it --rm --pids-limit 256 "${NET_ARGS[@]}" \
        "${user_args[@]}" \
        "${env_args[@]}" \
        -v "$vol_mount" -w /workspace \
        "${image_args[@]}"
}

devbox_basename() {
    B_NAME="airlock-$1"
}

devbox_exists() {
    [ -n "$($rt ps -a --filter "name=^/$B_NAME$" --format '{{.Names}}')" ]
}

devbox_validate_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

# Maps a distro name to its container image (default: Debian).
devbox_image_for_distro() {
    case "${1:-debian}" in
        alpine) echo "docker.io/library/alpine:latest" ;;
        fedora) echo "docker.io/library/fedora:latest" ;;
        ubuntu) echo "docker.io/library/ubuntu:latest" ;;
        debian|*) echo "docker.io/library/debian:stable" ;;
    esac
}

# Returns the shell available in a devbox image (Alpine has no bash).
devbox_shell_for_image() {
    case "$1" in
        *alpine*) echo "sh" ;;
        *) echo "bash" ;;
    esac
}

# Shell for a devbox's container image (used by devbox_enter).
devbox_shell() {
    devbox_shell_for_image "$($rt inspect --format '{{.Config.Image}}' "$B_NAME")"
}

# Prompts for a box OS (stdout: alpine|debian|fedora|ubuntu, prompts: stderr).
# Defaults to debian on empty/invalid input or when stdin is not interactive.
devbox_prompt_distro() {
    local distro
    echo "Choose an OS:" >&2
    echo "  1) Debian (default)" >&2
    echo "  2) Alpine" >&2
    echo "  3) Fedora" >&2
    echo "  4) Ubuntu" >&2
    if ! read -rp "Distro [debian]: " distro; then
        echo "(no input detected — using debian)" >&2
        echo "debian"
        return 0
    fi
    case "$distro" in
        ""|1|deb|debian) echo "debian" ;;
        2|al|alpine) echo "alpine" ;;
        3|fed|fedora) echo "fedora" ;;
        4|ub|ubuntu) echo "ubuntu" ;;
        *) echo "Invalid distro, using debian." >&2; echo "debian" ;;
    esac
}

devbox_create() {
    local name="$1" distro="${2:-debian}" image shell
    if [ -z "$name" ]; then
        echo "Error: box name required (e.g. airlock enter mysandbox)" >&2
        exit 1
    fi
    case "$distro" in
        alpine|debian|fedora|ubuntu) ;;
        *)
            echo "Error: invalid distro: '$distro' (expected alpine, debian, fedora, or ubuntu)" >&2
            exit 1
            ;;
    esac
    if ! devbox_validate_name "$name"; then
        echo "Error: invalid box name: '$name'" >&2
        echo "Names may contain letters, digits, '_', '.', '-' (no spaces)." >&2
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if devbox_exists; then
        echo "Devbox '$name' already exists ($B_NAME)" >&2
        exit 1
    fi
    image=$(devbox_image_for_distro "$distro")
    shell=$(devbox_shell_for_image "$image")
    $rt run -d --name "$B_NAME" --network host \
        "$image" "$shell" -c 'sleep infinity'
    echo "Created devbox '$name' ($B_NAME) [$distro]"
}

devbox_enter() {
    local name="$1"
    if [ -z "$name" ]; then
        echo "Error: box name required (e.g. airlock enter mysandbox)" >&2
        exit 1
    fi
    if ! devbox_validate_name "$name"; then
        echo "Error: invalid box name: '$name'" >&2
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if ! devbox_exists; then
        echo "Box '$name' does not exist yet." >&2
        devbox_create "$name" "$(devbox_prompt_distro)"
    elif [ "$($rt inspect -f '{{.State.Running}}' "$B_NAME")" != "true" ]; then
        $rt start "$B_NAME"
    fi
    $rt exec -it "$B_NAME" "$(devbox_shell)"
}

devbox_list() {
    rt=$(detect_runtime)
    $rt ps -a --filter "name=^/airlock-" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
}

# Prints existing devboxes (if any) before an interactive name prompt, so the
# user can see what's taken/what they can enter or remove.
devbox_show_existing() {
    local rt existing
    rt=$(detect_runtime)
    existing=$($rt ps -a --filter "name=^/airlock-" --format '{{.Names}}')
    if [ -n "$existing" ]; then
        echo "Existing devboxes:"
        $rt ps -a --filter "name=^/airlock-" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
    fi
}

devbox_delete() {
    local name="$1"
    if [ -z "$name" ]; then
        echo "Error: box name required (e.g. airlock delete mysandbox)" >&2
        exit 1
    fi
    if ! devbox_validate_name "$name"; then
        echo "Error: invalid box name: '$name'" >&2
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if ! devbox_exists; then
        echo "Devbox '$name' not found ($B_NAME)" >&2
        exit 1
    fi
    $rt rm -f "$B_NAME"
    echo "Removed devbox '$name' ($B_NAME)"
}

menu_devboxes() {
    while true; do
        echo
        echo "=== Development Boxes ==="
        echo "1) Enter a devbox (creates it if new)"
        echo "2) List devboxes"
        echo "3) Delete a devbox"
        echo "b) Back to main menu"
        echo "q) Quit"
        echo
        read -rp "Select option (or 'b' to go back, 'q' to quit): " choice

        case "$choice" in
            1|e|enter)
                devbox_show_existing
                read -rp "Devbox name: " name
                devbox_enter "$name"
                ;;
            2|l|list|ls) devbox_list ;;
            3|d|delete|rm|remove)
                devbox_show_existing
                read -rp "Devbox name: " name
                devbox_delete "$name"
                ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
        echo
    done
}

show_header() {
    local rt
    rt=$(detect_runtime)
    if [[ "$VERSION" =~ ^v?[0-9] ]]; then
        echo "Airlock v${VERSION#v}"
    else
        echo "Airlock ($VERSION)"
    fi
    printf 'Runtime: %s\n' "$rt"
    if is_selinux_enabled; then
        echo "SELinux: enabled (:z flag active)"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        echo "User:    $AIRLOCK_USER"
    elif [ "$rt" = "docker" ] && [ "$(id -u)" -ne 0 ]; then
        printf 'User:    %s:%s (host mapping active)\n' "$(id -u)" "$(id -g)"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            printf 'Config:  .airlock (runtime: %s)\n' "$CFG_RUNTIME"
        else
            echo "Config:  .airlock"
        fi
    fi
    echo "Project: $PROJECT_URL"
    local latest_version
    latest_version=$(get_latest_version)
    if [ "$latest_version" != "unavailable" ] && version_greater "$latest_version" "$VERSION"; then
        printf 'Latest:  %s (update available: re-run install.sh)\n' "$latest_version"
    fi
}

