#!/usr/bin/env bash
set -e

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
VERSION="0.0.1"
PROJECT_URL="https://github.com/besoeasy/airlock"
REMOTE_VERSION_URL="https://raw.githubusercontent.com/besoeasy/airlock/main/.ver"

get_remote_version() {
    local remote_version
    if remote_version=$(curl -fsSL --connect-timeout 2 --max-time 3 "$REMOTE_VERSION_URL" 2>/dev/null); then
        printf '%s' "$remote_version" | tr -d '[:space:]'
    else
        echo "unavailable"
    fi
}

show_version() {
    local remote_version
    remote_version=$(get_remote_version)

    echo "Airlock version: $VERSION"
    echo "Remote version: $remote_version"
    if is_selinux_enabled; then
        echo "SELinux: enabled (:z flag active)"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        echo "User mapping: $AIRLOCK_USER"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            echo "Config: .airlock (runtime: $CFG_RUNTIME)"
        else
            echo "Config: .airlock"
        fi
    fi
}

ensure_path() {
    local bin_dir="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
        export PATH="$bin_dir:$PATH"
    fi
}

is_selinux_enabled() {
    if [ "${AIRLOCK_SELINUX:-}" = "0" ] || [ "${AIRLOCK_SELINUX:-}" = "false" ]; then
        return 1
    fi
    if [ "${AIRLOCK_SELINUX:-}" = "1" ] || [ "${AIRLOCK_SELINUX:-}" = "true" ]; then
        return 0
    fi
    if command -v selinuxenabled >/dev/null 2>&1; then
        selinuxenabled
    elif [ -f /sys/fs/selinux/enforce ]; then
        return 0
    else
        return 1
    fi
}

detect_runtime() {
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        echo "Error: docker or podman required." >&2
        exit 1
    fi
}

CFG_FOUND=false
CFG_RUNTIME=""
CFG_PORTS=""
CFG_NETWORK=""
CFG_USER=""
CFG_SELINUX=""
declare -a CFG_ENVS=()

load_airlock_config() {
    local config_file="${PWD}/.airlock"
    [ -f "$config_file" ] || return 0
    CFG_FOUND=true

    while IFS= read -r line || [ -n "$line" ]; do
        # Trim leading and trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [ -z "$line" ] && continue
        [[ "$line" == \#* ]] && continue

        if [[ "$line" == *"="* ]]; then
            local key="${line%%=*}"
            local val="${line#*=}"

            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            key="$(echo "$key" | tr '[:upper:]' '[:lower:]')"

            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            case "$val" in
                \"*\") val="${val#\"}"; val="${val%\"}" ;;
                \'*\') val="${val#\'}"; val="${val%\'}" ;;
            esac

            case "$key" in
                runtime)
                    CFG_RUNTIME="$val"
                    ;;
                ports|port)
                    CFG_PORTS="$val"
                    ;;
                network|net)
                    CFG_NETWORK="$val"
                    ;;
                user)
                    CFG_USER="$val"
                    ;;
                selinux)
                    CFG_SELINUX="$val"
                    ;;
                env)
                    CFG_ENVS+=("$val")
                    ;;
            esac
        else
            if [ -z "$CFG_RUNTIME" ]; then
                CFG_RUNTIME="$line"
            fi
        fi
    done < "$config_file"

    if [ -n "$CFG_SELINUX" ] && [ -z "${AIRLOCK_SELINUX:-}" ]; then
        AIRLOCK_SELINUX="$CFG_SELINUX"
    fi
    if [ -n "$CFG_USER" ] && [ -z "${AIRLOCK_USER:-}" ]; then
        AIRLOCK_USER="$CFG_USER"
    fi
}

is_valid_port() {
    [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Populates the NET_ARGS array (declared by the caller, launch()).
# Never build these as an interpolated string: unquoted expansion of a
# plain string lets a space-containing value smuggle extra flags (e.g.
# network=host --privileged) into the container runtime invocation.
get_network_args() {
    NET_ARGS=()

    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_PORTS" ]; then
            local p
            for p in $CFG_PORTS; do
                is_valid_port "$p" || { echo "Invalid .airlock ports entry: '$p' (expected a number 1-65535)" >&2; exit 1; }
                NET_ARGS+=(-p "$p:$p")
            done
        elif [ -n "$CFG_NETWORK" ]; then
            [[ "$CFG_NETWORK" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "Invalid .airlock network entry: '$CFG_NETWORK' (expected a simple name like host, bridge, none)" >&2; exit 1; }
            NET_ARGS=(--network "$CFG_NETWORK")
        else
            NET_ARGS=(--network host)
        fi
        return
    fi

    local ports
    read -rp "Ports to open (space-separated, e.g. 3000 8080) or Enter for --network host: " ports

    if [ -z "$ports" ]; then
        NET_ARGS=(--network host)
    else
        local p
        for p in $ports; do
            is_valid_port "$p" || { echo "Invalid port: '$p' (expected a number 1-65535)" >&2; exit 1; }
            NET_ARGS+=(-p "$p:$p")
        done
    fi
}

launch() {
    local name="$1"
    local rt
    rt=$(detect_runtime)
    local -a NET_ARGS
    get_network_args

    local vol_mount="${PWD}:/workspace"
    if is_selinux_enabled; then
        vol_mount="${vol_mount}:z"
    fi

    local -a user_args=()
    if [ -n "${AIRLOCK_USER:-}" ]; then
        if [ "$AIRLOCK_USER" != "0" ] && [ "$AIRLOCK_USER" != "root" ]; then
            user_args=(--user "$AIRLOCK_USER" -e HOME=/tmp)
        fi
    elif [ "$rt" = "docker" ] && [ "$(id -u)" -ne 0 ]; then
        user_args=(--user "$(id -u):$(id -g)" -e HOME=/tmp)
    fi

    local -a image_args
    case "$name" in
        aider)
            image_args=(
                -e OPENAI_API_KEY -e ANTHROPIC_API_KEY -e GEMINI_API_KEY -e OPENROUTER_API_KEY -e DEEPSEEK_API_KEY
                docker.io/paulgauthier/aider
            )
            ;;
        alpine)
            image_args=(docker.io/library/alpine:latest sh)
            ;;
        archlinux|arch)
            image_args=(docker.io/library/archlinux:latest bash)
            ;;
        bun)
            image_args=(docker.io/oven/bun:latest bash)
            ;;
        c|cpp|gcc)
            image_args=(docker.io/library/gcc:latest bash)
            ;;
        debian)
            image_args=(docker.io/library/debian:stable bash)
            ;;
        deno)
            image_args=(--entrypoint /bin/bash docker.io/denoland/deno:latest)
            ;;
        fedora)
            image_args=(docker.io/library/fedora:latest bash)
            ;;
        go)
            image_args=(docker.io/library/golang:latest bash)
            ;;
        kali|kalilinux)
            image_args=(docker.io/kalilinux/kali-rolling:latest bash)
            ;;
        nix)
            image_args=(docker.io/nixos/nix:latest sh)
            ;;
        node)
            image_args=(docker.io/library/node:lts bash)
            ;;
        opencode)
            image_args=(ghcr.io/anomalyco/opencode)
            ;;
        php)
            image_args=(docker.io/library/php:cli bash)
            ;;
        python)
            image_args=(docker.io/library/python:3 bash)
            ;;
        ruby)
            image_args=(docker.io/library/ruby:latest bash)
            ;;
        rust)
            image_args=(docker.io/library/rust:latest bash)
            ;;
        trivy|semgrep)
            image_args=(docker.io/aquasec/trivy:latest fs /workspace)
            ;;
        ubuntu)
            image_args=(docker.io/library/ubuntu:latest bash)
            ;;
        zig)
            image_args=(--entrypoint /bin/sh docker.io/euantorano/zig:latest)
            ;;
        *)
            echo "Unknown runtime: $name" >&2
            echo "Runtimes: aider, alpine, archlinux, bun, c, debian, deno, fedora, gcc, go, kali, nix, node, opencode, php, python, ruby, rust, trivy, ubuntu, zig" >&2
            exit 1
            ;;
    esac

    local -a env_args=()
    if [ "${#CFG_ENVS[@]}" -gt 0 ]; then
        for env_item in "${CFG_ENVS[@]}"; do
            env_args+=(-e "$env_item")
        done
    fi

    $rt run -it --rm --pids-limit 256 "${NET_ARGS[@]}" \
        "${user_args[@]}" \
        "${env_args[@]}" \
        -v "$vol_mount" -w /workspace \
        "${image_args[@]}"
}

show_header() {
    local rt
    rt=$(detect_runtime)
    local remote_version
    remote_version=$(get_remote_version)
    echo "Airlock v$VERSION"
    printf 'Runtime: %s\n' "$rt"
    if is_selinux_enabled; then
        echo "SELinux: enabled (:z flag active)"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        echo "User:    $AIRLOCK_USER"
    elif [ "$rt" = "docker" ] && [ "$(id -u)" -ne 0 ]; then
        printf 'User:    %s:%s (host mapping active)\n' "$(id -u)" "$(id -g)"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            printf 'Config:  .airlock (runtime: %s)\n' "$CFG_RUNTIME"
        else
            echo "Config:  .airlock"
        fi
    fi
    echo "Project: $PROJECT_URL"
    if [ "$remote_version" != "unavailable" ] && [ -n "$remote_version" ] && [ "$remote_version" != "$VERSION" ]; then
        printf 'Latest:  %s (update available: %s)\n' "$remote_version" "$PROJECT_URL"
    else
        printf 'Latest:  %s\n' "$remote_version"
    fi
}

menu_languages() {
    while true; do
        echo
        echo "=== Programming Languages ==="
        echo "1) Bun"
        echo "2) C / C++ (GCC)"
        echo "3) Deno"
        echo "4) Go"
        echo "5) Node.js"
        echo "6) PHP"
        echo "7) Python"
        echo "8) Ruby"
        echo "9) Rust"
        echo "10) Zig"
        echo "b) Back to categories"
        echo "q) Quit"
        echo
        read -rp "Select language (or 'b' to go back, 'q' to quit): " choice

        case "$choice" in
            1|bun) launch bun; exit 0 ;;
            2|c|cpp|gcc) launch gcc; exit 0 ;;
            3|deno) launch deno; exit 0 ;;
            4|go|golang) launch go; exit 0 ;;
            5|node|nodejs) launch node; exit 0 ;;
            6|php) launch php; exit 0 ;;
            7|python|py) launch python; exit 0 ;;
            8|ruby|rb) launch ruby; exit 0 ;;
            9|rust|rs) launch rust; exit 0 ;;
            10|zig) launch zig; exit 0 ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
    done
}

menu_distros() {
    while true; do
        echo
        echo "=== Linux Distributions ==="
        echo "1) Alpine"
        echo "2) Arch Linux"
        echo "3) Debian"
        echo "4) Fedora"
        echo "5) Nix"
        echo "6) Ubuntu"
        echo "b) Back to categories"
        echo "q) Quit"
        echo
        read -rp "Select distribution (or 'b' to go back, 'q' to quit): " choice

        case "$choice" in
            1|alpine) launch alpine; exit 0 ;;
            2|arch|archlinux) launch archlinux; exit 0 ;;
            3|debian) launch debian; exit 0 ;;
            4|fedora) launch fedora; exit 0 ;;
            5|nix) launch nix; exit 0 ;;
            6|ubuntu) launch ubuntu; exit 0 ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
    done
}

menu_ai() {
    while true; do
        echo
        echo "=== AI Coding Agents ==="
        echo "1) Aider"
        echo "2) OpenCode"
        echo "b) Back to categories"
        echo "q) Quit"
        echo
        read -rp "Select AI agent (or 'b' to go back, 'q' to quit): " choice

        case "$choice" in
            1|aider) launch aider; exit 0 ;;
            2|opencode) launch opencode; exit 0 ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
    done
}

menu_security() {
    while true; do
        echo
        echo "=== Security & Auditing ==="
        echo "1) Kali Linux"
        echo "2) Trivy (Security Scanner)"
        echo "b) Back to categories"
        echo "q) Quit"
        echo
        read -rp "Select tool (or 'b' to go back, 'q' to quit): " choice

        case "$choice" in
            1|kali|kalilinux) launch kali; exit 0 ;;
            2|trivy|semgrep) launch trivy; exit 0 ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
    done
}

menu() {
    while true; do
        show_header
        echo
        echo "Select a category:"
        echo "1) Programming Languages  (Bun, C/C++, Deno, Go, Node, PHP, Python, Ruby, Rust, Zig)"
        echo "2) Linux Distributions    (Alpine, Arch, Debian, Fedora, Nix, Ubuntu)"
        echo "3) AI Coding Agents       (Aider, OpenCode)"
        echo "4) Security & Auditing    (Kali Linux, Trivy)"
        echo "q) Quit"
        echo
        read -rp "Select category (or 'q' to quit): " choice

        case "$choice" in
            1|lang|languages) menu_languages ;;
            2|distro|distros|linux) menu_distros ;;
            3|ai|agent|agents) menu_ai ;;
            4|sec|security) menu_security ;;
            q|Q|exit|"") exit 0 ;;
            *) echo "Invalid option." >&2 ;;
        esac
        echo
    done
}

show_help() {
    echo "Usage: airlock [options] [runtime]"
    echo
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -v, --version  Show local and remote versions"
    echo
    echo "Available runtimes:"
    echo "  Languages: bun, c, cpp, deno, gcc, go, node, php, python, ruby, rust, zig"
    echo "  Distros:   alpine, arch, debian, fedora, nix, ubuntu"
    echo "  AI Agents: aider, opencode"
    echo "  Security:  kali, trivy"
    echo
    echo "Configuration file (.airlock):"
    echo "  When a .airlock file is present in the current directory, Airlock"
    echo "  automatically launches the container with your configuration"
    echo "  and skips interactive questions."
    echo
    echo "  Supported keys in .airlock:"
    echo "    runtime=<name>       Container runtime (or single-token name, e.g. node)"
    echo "    ports=<port ...>     Space-separated ports to expose (e.g. 3000 8080)"
    echo "    network=<mode>       Network mode (host, bridge, none; default: host)"
    echo "    user=<uid:gid>       Override container user"
    echo "    env=<KEY=VALUE>      Environment variable (repeatable)"
    echo "    selinux=1|0          Enable or disable SELinux :z volume relabeling"
    echo
    echo "Environment variables:"
    echo "  AIRLOCK_SELINUX=1|0      Force enable or disable SELinux :z volume relabeling"
    echo "  AIRLOCK_USER=<uid:gid>   Override container user (defaults to host user for Docker)"
}

ensure_path
load_airlock_config

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    show_version
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_help
elif [ -n "${1:-}" ]; then
    case "$1" in
        aider|alpine|arch|archlinux|bun|c|cpp|gcc|debian|deno|fedora|go|kali|kalilinux|nix|node|opencode|php|python|ruby|rust|semgrep|trivy|ubuntu|zig)
            launch "$1"
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: airlock [-h|--help] [-v|--version] [runtime]" >&2
            exit 1
            ;;
    esac
elif [ -n "$CFG_RUNTIME" ]; then
    echo "Found .airlock configuration (runtime: $CFG_RUNTIME)"
    launch "$CFG_RUNTIME"
else
    menu
fi

