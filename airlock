    printf "%sUsage:%s airlock [options] [runtime]\n" "$C_BOLD" "$C_RESET"
    echo
    printf "%sOptions:%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    echo "  -h, --help     Show this help message"
    echo "  -v, --version  Show version"
    echo
    printf "%sCommands:%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    printf "  %sinit%s [runtime]       Create a starter .airlock file (auto-detects when omitted)\n" "$C_GREEN" "$C_RESET"
    printf "  %scompletion%s <shell>   Print completion script (bash, zsh, fish)\n" "$C_GREEN" "$C_RESET"
    printf "  %senter%s <name>         Enter a persistent box (asks OS when creating a new one)\n" "$C_GREEN" "$C_RESET"
    echo "  list                 List all persistent boxes"
    echo "  delete <name>        Delete a persistent box"
    echo
    printf "%sAvailable runtimes:%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    echo "  Languages: bun, c, cpp, deno, gcc, go, node, php, python, ruby, rust, zig"
    echo "  Distros:   alpine, arch, busybox, debian, fedora, nix, ubuntu"
    echo "  Tools:     gitleaks, grype, hadolint, kali, nmap, opencode, semgrep, shellcheck, trivy"
    echo
    printf "%sDevelopment boxes:%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    echo "  airlock enter mybox           Enter a box; asks OS (debian, alpine, fedora, ubuntu, archlinux) if new"
    echo "  airlock list                  List all boxes"
    echo "  airlock delete mybox          Delete a box and its state"
    echo
    printf "%sConfiguration file (.airlock):%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    echo "  When a .airlock file is present in the current directory, Airlock"
    echo "  automatically launches the container with your configuration"
    echo "  and skips interactive questions."
    echo
    echo "  Supported keys in .airlock:"
    echo "    runtime=<name>       Container runtime (or single-token name, e.g. node)"
    echo "    ports=<port ...>     Space-separated ports to expose (e.g. 3000 8080)"
    echo "    network=<mode>       Network mode (host, bridge, none; default: host)"
    echo "    user=<uid:gid>       Override container user"
    echo "    env=<KEY=VALUE>      Environment variable (repeatable)"
    echo "    selinux=1|0          Enable or disable SELinux :z volume relabeling"
    echo "    setup=<command>      Command to run on container startup before opening shell"
    echo "    shell=<name>         Shell override (e.g. bash, sh; auto-detected if omitted)"
