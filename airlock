detect_project_runtime() {
    if [ -f ./deno.json ] || [ -f ./deno.jsonc ]; then echo "deno"; return 0; fi
    if [ -f ./bun.lockb ] || [ -f ./bunfig.toml ]; then echo "bun"; return 0; fi
    if [ -f ./package.json ]; then echo "node"; return 0; fi
    if [ -f ./go.mod ]; then echo "go"; return 0; fi
    if [ -f ./Cargo.toml ]; then echo "rust"; return 0; fi
    if [ -f ./composer.json ]; then echo "php"; return 0; fi
    if [ -f ./Gemfile ]; then echo "ruby"; return 0; fi
    if [ -f ./pyproject.toml ] || [ -f ./requirements.txt ] || [ -f ./.python-version ]; then echo "python"; return 0; fi
    if [ -f ./build.zig ] || [ -f ./build.zig.zon ]; then echo "zig"; return 0; fi
    if [ -f ./Makefile ] || [ -f ./CMakeLists.txt ]; then echo "c"; return 0; fi
    return 1
}

init_usage() {
    echo "Usage: airlock init [runtime] [-f|--force]" >&2
    echo "  Creates a starter .airlock file in the current directory." >&2
    echo "  Without a runtime, Airlock auto-detects from project files or prompts." >&2
}

init_cmd() {
    local runtime="" force=false arg
    for arg in "$@"; do
        case "$arg" in
            -f|--force) force=true ;;
            -h|--help) init_usage; return 0 ;;
            -*)
                echo "Unknown init option: $arg" >&2
                init_usage; exit 1 ;;
            *)
                if [ -n "$runtime" ]; then
                    echo "Error: too many arguments (expected one runtime)" >&2
                    init_usage; exit 1
                fi
                runtime="$arg" ;;
        esac
    done

    if [ -z "$runtime" ]; then
        if runtime="$(detect_project_runtime)"; then
            echo "Detected runtime: $runtime"
        elif [ -t 0 ]; then
            read -rp "Runtime (e.g. node, python, go): " runtime
        else
            echo "Error: runtime required (e.g. airlock init node)" >&2
            init_usage; exit 1
        fi
    fi

    runtime="$(echo "$runtime" | tr '[:upper:]' '[:lower:]')"
    if ! is_known_runtime "$runtime"; then
        echo "Unknown runtime: $runtime" >&2
        echo "Runtimes: $RUNTIMES_ALL" >&2
        exit 1
    fi

    if [ -f ./.airlock ] && [ "$force" = false ]; then
        echo "Error: .airlock already exists (use --force to overwrite)" >&2
        exit 1
    fi

    cat > ./.airlock <<EOF
# .airlock — Airlock runtime configuration
# Docs: $PROJECT_URL#configuration-airlock
runtime=$runtime
# ports=3000 8080
# network=host
# user=
# env=KEY=VALUE
# selinux=
EOF
    echo "Created .airlock (runtime: $runtime)"
}

completion_usage() {
    echo "Usage: airlock completion <bash|zsh|fish>" >&2
    echo "  Prints a completion script to stdout." >&2
    echo "  Examples:" >&2
    echo "    airlock completion bash >> ~/.bashrc" >&2
    echo "    airlock completion zsh > ~/.zfunc/_airlock" >&2
    echo "    airlock completion fish > ~/.config/fish/completions/airlock.fish" >&2
}

completion_bash() {
    cat <<EOF
# airlock bash completion (generated by \`airlock completion bash\`)
_airlock_completions() {
    local cur prev runtimes
    COMPREPLY=()
    cur="\${COMP_WORDS[COMP_CWORD]}"
    prev="\${COMP_WORDS[COMP_CWORD-1]}"
    runtimes="$RUNTIMES_ALL"
    case "\$prev" in
        airlock)
            COMPREPLY=( \$(compgen -W "\$runtimes enter list delete init completion -h --help -v --version" -- "\$cur") )
            ;;
        init)
            COMPREPLY=( \$(compgen -W "\$runtimes" -- "\$cur") )
            ;;
        completion)
            COMPREPLY=( \$(compgen -W "bash zsh fish" -- "\$cur") )
            ;;
    esac
    return 0
}
complete -F _airlock_completions airlock
EOF
}

completion_zsh() {
    cat <<EOF
#compdef airlock
# airlock zsh completion (generated by \`airlock completion zsh\`)
_airlock() {
    local -a runtimes
    runtimes=($RUNTIMES_ALL)
    _arguments -C \\
        '1: :->cmd' \\
        '*: :->args' && return 0
    case \$state in
        cmd)
            _describe 'command' 'runtimes:run a runtime enter:enter-box list:list-boxes delete:delete-box init:create-.airlock completion:print-completion -h:help --help:help -v:version --version:version' && return 0
            _describe 'runtime' runtimes && return 0
            ;;
        args)
            case \$words[2] in
                init) _describe 'runtime' runtimes && return 0 ;;
                completion) _describe 'shell' 'bash:bash zsh:zsh fish:fish' && return 0 ;;
            esac
            ;;
    esac
    return 1
}
compdef _airlock airlock
EOF
}

completion_fish() {
    cat <<EOF
# airlock fish completion (generated by \`airlock completion fish\`)
set -l runtimes $RUNTIMES_ALL
complete -c airlock -f
complete -c airlock -n __fish_use_subcommand -a "$runtimes" -d 'runtime'
complete -c airlock -n __fish_use_subcommand -a enter -d 'enter a persistent box'
complete -c airlock -n __fish_use_subcommand -a list -d 'list persistent boxes'
complete -c airlock -n __fish_use_subcommand -a delete -d 'delete a persistent box'
complete -c airlock -n __fish_use_subcommand -a init -d 'create .airlock'
complete -c airlock -n __fish_use_subcommand -a completion -d 'print completion'
complete -c airlock -n __fish_use_subcommand -s h -l help -d 'show help'
complete -c airlock -n __fish_use_subcommand -s v -l version -d 'show version'
complete -c airlock -n '__fish_seen_subcommand_from init' -a "\$runtimes"
complete -c airlock -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
EOF
}

completion_cmd() {
    case "${1:-}" in
        bash) completion_bash ;;
        zsh) completion_zsh ;;
        fish) completion_fish ;;
        -h|--help|"") completion_usage ;;
        *) echo "Unknown shell: $1 (expected bash, zsh, or fish)" >&2; completion_usage; exit 1 ;;
    esac
}

show_help() {
    echo "Usage: airlock [options] [runtime]"
    echo
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -v, --version  Show version"
    echo
    echo "Commands:"
    echo "  init [runtime]            Create a starter .airlock file (auto-detects when omitted)"
    echo "  completion <shell>        Print completion script (bash, zsh, fish)"
    echo "  enter <name>              Enter a persistent box (asks OS when creating a new one)"
    echo "  list                      List all persistent boxes"
    echo "  delete <name>             Delete a persistent box"
    echo
    echo "Available runtimes:"
    echo "  Languages: bun, c, cpp, deno, gcc, go, node, php, python, ruby, rust, zig"
    echo "  Distros:   alpine, arch, debian, fedora, nix, ubuntu"
    echo "  AI Agents: aider, opencode"
    echo "  Security:  kali, trivy"
    echo
    echo "Development boxes:"
    echo "  airlock enter mybox           Enter a box; asks OS (debian, alpine, fedora, ubuntu) if new"
    echo "  airlock list                  List all boxes"
    echo "  airlock delete mybox          Delete a box and its state"
    echo
    echo "Configuration file (.airlock):"
    echo "  When a .airlock file is present in the current directory, Airlock"
    echo "  automatically launches the container with your configuration"
    echo "  and skips interactive questions."
    echo
    echo "  Supported keys in .airlock:"
    echo "    runtime=<name>       Container runtime (or single-token name, e.g. node)"
    echo "    ports=<port ...>     Space-separated ports to expose (e.g. 3000 8080)"
    echo "    network=<mode>       Network mode (host, bridge, none; default: host)"
    echo "    user=<uid:gid>       Override container user"
    echo "    env=<KEY=VALUE>      Environment variable (repeatable)"
    echo "    selinux=1|0          Enable or disable SELinux :z volume relabeling"
    echo
    echo "Environment variables:"
    echo "  AIRLOCK_SELINUX=1|0      Force enable or disable SELinux :z volume relabeling"
    echo "  AIRLOCK_USER=<uid:gid>   Override container user (defaults to host user for Docker)"
}

ensure_path
load_airlock_config

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    show_version
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_help
elif [ -n "${1:-}" ]; then
    case "$1" in
        aider|alpine|arch|archlinux|bun|c|cpp|gcc|debian|deno|fedora|go|kali|kalilinux|nix|node|opencode|php|python|ruby|rust|semgrep|trivy|ubuntu|zig)
            launch "$1"
            ;;
        enter)
            if [ -n "${3:-}" ]; then
                echo "Error: too many arguments (expected 'airlock enter <name>')" >&2
                exit 1
            fi
            devbox_enter "${2:-}"
            ;;
        list)
            if [ -n "${2:-}" ]; then
                echo "Error: 'airlock list' takes no arguments (did you mean 'airlock enter $2'?)" >&2
                exit 1
            fi
            devbox_list ;;
        delete|rm|remove)
            if [ -n "${3:-}" ]; then
                echo "Error: too many arguments (expected 'airlock delete <name>')" >&2
                exit 1
            fi
            devbox_delete "${2:-}"
            ;;
        init)
            shift
            init_cmd "$@"
            ;;
        completion)
            completion_cmd "${2:-}"
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: airlock [-h|--help] [-v|--version] [runtime] [enter <name>] [list] [delete <name>] [init] [completion <shell>]" >&2
            exit 1
            ;;
    esac
elif [ -n "$CFG_RUNTIME" ]; then
    if ! is_known_runtime "$CFG_RUNTIME"; then
        echo "Invalid .airlock runtime: '$CFG_RUNTIME'" >&2
        echo "Runtimes: $RUNTIMES_ALL" >&2
        exit 1
    fi
    echo "Found .airlock configuration (runtime: $CFG_RUNTIME)"
    launch "$CFG_RUNTIME"
else
    menu
fi

