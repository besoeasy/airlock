    printf "%sEnvironment variables:%s\n" "$C_BOLD$C_CYAN" "$C_RESET"
    echo "  AIRLOCK_SELINUX=1|0      Force enable or disable SELinux :z volume relabeling"
    echo "  AIRLOCK_USER=<uid:gid>   Override container user (default: container default)"
    echo "  NO_COLOR=1               Disable colors"
}

ensure_path
load_airlock_config

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    show_version
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    show_help
elif [ -n "${1:-}" ]; then
    case "$1" in
        alpine|arch|archlinux|bun|busybox|c|cpp|gcc|debian|deno|fedora|gitleaks|go|grype|hadolint|kali|kalilinux|nix|node|nmap|opencode|php|python|ruby|rust|semgrep|shellcheck|trivy|ubuntu|zig)
            launch "$1"
            ;;
        enter)
            if [ -n "${3:-}" ]; then
                error "Error: too many arguments (expected 'airlock enter <name>')"
                exit 1
            fi
            devbox_enter "${2:-}"
            ;;
        list)
            if [ -n "${2:-}" ]; then
                error "Error: 'airlock list' takes no arguments (did you mean 'airlock enter $2'?)"
                exit 1
            fi
            devbox_list ;;
        delete|rm|remove)
            if [ -n "${3:-}" ]; then
                error "Error: too many arguments (expected 'airlock delete <name>')"
                exit 1
            fi
            devbox_delete "${2:-}"
            ;;
        init)
            shift
            init_cmd "$@"
            ;;
        completion)
            completion_cmd "${2:-}"
            ;;
        *)
            error "Unknown option: $1"
            dim "Usage: airlock [-h|--help] [-v|--version] [runtime] [enter <name>] [list] [delete <name>] [init] [completion <shell>]"
            exit 1
            ;;
    esac
elif [ -n "$CFG_RUNTIME" ]; then
    if ! is_known_runtime "$CFG_RUNTIME"; then
        error "Invalid .airlock runtime: '$CFG_RUNTIME'"
        error "Runtimes: $RUNTIMES_ALL"
        exit 1
    fi
    info "✓ Found .airlock configuration (runtime: $CFG_RUNTIME)"
    launch "$CFG_RUNTIME"
else
    menu
fi

