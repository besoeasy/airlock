#!/usr/bin/env bash
set -e

VERSION="dev"
PROJECT_URL="https://github.com/besoeasy/airlock"
GITHUB_REPO="besoeasy/airlock"
RELEASE_WEB_URL="https://github.com/${GITHUB_REPO}/releases/latest"

# Modern terminal styling (dependency-free, respects NO_COLOR + pipes).
# Colors only apply to Airlock's own UI, never to container output.
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'; C_RED=$'\e[31m'; C_GREEN=$'\e[32m'
    C_YELLOW=$'\e[33m'; C_BLUE=$'\e[34m'; C_MAGENTA=$'\e[35m'; C_CYAN=$'\e[36m'
    C_RESET=$'\e[0m'
else
    C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""
    C_YELLOW=""; C_BLUE=""; C_MAGENTA=""; C_CYAN=""; C_RESET=""
fi

info() { printf "%s%s%s\n" "$C_GREEN" "$*" "$C_RESET"; }
warn() { printf "%s%s%s\n" "$C_YELLOW" "$*" "$C_RESET" >&2; }
error() { printf "%s%s%s\n" "$C_RED" "$*" "$C_RESET" >&2; }
dim() { printf "%s%s%s\n" "$C_DIM" "$*" "$C_RESET"; }
hdr() { printf "\n%s%s%s%s\n" "$C_BOLD$C_CYAN" "$*" "$C_RESET"; }

# Latest released version via GitHub releases web redirect + local TTL cache.
# Bypasses the unauthenticated 60 req/hr GitHub REST API rate limit.
# Cached locally for 1 hour to ensure instantaneous menu rendering and offline resilience.
get_latest_version() {
    local cache_dir cache_file now cache_time
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        cache_dir="$XDG_CACHE_HOME/airlock"
    elif [ -n "${HOME:-}" ]; then
        cache_dir="$HOME/.cache/airlock"
    else
        cache_dir="/tmp"
    fi
    cache_file="${cache_dir}/latest_version"

    now=$(date +%s 2>/dev/null || echo 0)

    # Return cached version if less than 1 hour old (3600 seconds)
    if [ -f "$cache_file" ]; then
        cache_time=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
        if [ "$now" -gt 0 ] && [ "$cache_time" -gt 0 ] && [ $((now - cache_time)) -lt 3600 ]; then
            cat "$cache_file" 2>/dev/null && return 0
        fi
    fi

    # Query via GitHub web redirect (bypasses api.github.com rate limit)
    local effective_url="" tag=""
    if command -v curl >/dev/null 2>&1; then
        effective_url=$(curl -fsSL --connect-timeout 2 --max-time 4 -o /dev/null -w "%{url_effective}" "$RELEASE_WEB_URL" 2>/dev/null || true)
    elif command -v wget >/dev/null 2>&1; then
        effective_url=$(wget -q -S --spider --timeout=4 "$RELEASE_WEB_URL" 2>&1 | grep -i '^[[:space:]]*location:' | tail -n1 | awk '{print $2}')
    fi

    tag="${effective_url##*/}"
    tag="${tag#v}"

    if [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        mkdir -p "$cache_dir" 2>/dev/null || true
        echo "$tag" > "$cache_file" 2>/dev/null || true
        echo "$tag"
        return 0
    fi

    # Fall back to existing cached version if offline or query failed
    if [ -f "$cache_file" ]; then
        cat "$cache_file" 2>/dev/null && return 0
    fi

    echo "unavailable"
}

# Returns 0 if version $1 is newer than version $2 (numeric per-component).
# Non-numeric suffixes are ignored ("1.2-rc1" compares as "1.2").
# Supports CalVer with a same-day counter (2026.09.16.1).
version_greater() {
    local a="${1#v}" b="${2#v}" i ai bi
    local IFS=.
    local a_parts=($a) b_parts=($b)
    for i in 0 1 2 3; do
        ai="${a_parts[$i]:-0}"; bi="${b_parts[$i]:-0}"
        ai="${ai%%[^0-9]*}"; bi="${bi%%[^0-9]*}"
        ai="${ai:-0}"; bi="${bi:-0}"
        if [ "$ai" -gt "$bi" ] 2>/dev/null; then return 0; fi
        if [ "$ai" -lt "$bi" ] 2>/dev/null; then return 1; fi
    done
    return 1
}

# Canonical runtimes + accepted aliases (single source for help and completions).
RUNTIMES_ALL="alpine arch archlinux bun busybox c cpp gcc debian deno fedora gitleaks go grype hadolint kali kalilinux nix node nmap opencode php python ruby rust semgrep shellcheck trivy ubuntu zig"

is_known_runtime() {
    case "$1" in
        alpine|arch|archlinux|bun|busybox|c|cpp|gcc|debian|deno|fedora|gitleaks|go|grype|hadolint|kali|kalilinux|nix|node|nmap|opencode|php|python|ruby|rust|semgrep|shellcheck|trivy|ubuntu|zig)
            return 0 ;;
        *) return 1 ;;
    esac
}

show_version() {
    local latest_version
    latest_version=$(get_latest_version)

    printf "%sAirlock%s %s%s%s\n" "$C_BOLD$C_CYAN" "$C_RESET" "$C_BOLD" "$VERSION" "$C_RESET"
    printf "%sLatest release:%s %s\n" "$C_DIM" "$C_RESET" "$latest_version"
    # Only release-stamped copies (installed via install.sh) get an update
    # verdict; dev checkouts and manual copies just report what they are.
    if [[ "$VERSION" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]] && [ "$latest_version" != "unavailable" ] && version_greater "$latest_version" "$VERSION"; then
        printf "%sUpdate available:%s %s\n" "$C_YELLOW$C_BOLD" "$C_RESET" "$latest_version"
        printf "  %sTo update, re-run the installer from GitHub:%s\n" "$C_DIM" "$C_RESET"
        printf "  curl -fsSL https://cdn.jsdelivr.net/gh/besoeasy/airlock@main/install.sh | bash\n"
    fi
    if is_selinux_enabled; then
        printf "%sSELinux:%s enabled (:z flag active)\n" "$C_DIM" "$C_RESET"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        printf "%sUser mapping:%s %s\n" "$C_DIM" "$C_RESET" "$AIRLOCK_USER"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            printf "%sConfig:%s .airlock (runtime: %s%s%s)\n" "$C_DIM" "$C_RESET" "$C_GREEN" "$CFG_RUNTIME" "$C_RESET"
        else
            printf "%sConfig:%s .airlock\n" "$C_DIM" "$C_RESET"
        fi
        if [ -n "$CFG_SETUP" ]; then
            printf "%sSetup:%s  %s\n" "$C_DIM" "$C_RESET" "$CFG_SETUP"
        fi
    fi
}

ensure_path() {
    local bin_dir="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
        export PATH="$bin_dir:$PATH"
    fi
}

is_selinux_enabled() {
    if [ "${AIRLOCK_SELINUX:-}" = "0" ] || [ "${AIRLOCK_SELINUX:-}" = "false" ]; then
        return 1
    fi
    if [ "${AIRLOCK_SELINUX:-}" = "1" ] || [ "${AIRLOCK_SELINUX:-}" = "true" ]; then
        return 0
    fi
    if command -v selinuxenabled >/dev/null 2>&1; then
        selinuxenabled
    elif [ -f /sys/fs/selinux/enforce ]; then
        return 0
    else
        return 1
    fi
}

# Podman is the only supported engine. It is rootless, so containers
# already run as your user and no UID/GID mapping is needed.
detect_runtime() {
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    else
        echo "Error: Podman is required but not installed." >&2
        echo "Install it with your package manager (e.g. sudo apt install podman)" >&2
        echo "or re-run install.sh, which installs it automatically." >&2
        exit 1
    fi
}

CFG_FOUND=false
CFG_RUNTIME=""
CFG_PORTS=""
CFG_NETWORK=""
CFG_USER=""
CFG_SELINUX=""
CFG_SETUP=""
CFG_SHELL=""
declare -a CFG_ENVS=()

load_airlock_config() {
    local config_file="${PWD}/.airlock"
    [ -f "$config_file" ] || return 0
    CFG_FOUND=true

    while IFS= read -r line || [ -n "$line" ]; do
        # Trim leading and trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [ -z "$line" ] && continue
        [[ "$line" == \#* ]] && continue

        if [[ "$line" == *"="* ]]; then
            local key="${line%%=*}"
            local val="${line#*=}"

            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            key="$(echo "$key" | tr '[:upper:]' '[:lower:]')"

            val="${val#"${val%%[![:space:]]*}"}"
            val="${val%"${val##*[![:space:]]}"}"
            case "$val" in
                \"*\") val="${val#\"}"; val="${val%\"}" ;;
                \'*\') val="${val#\'}"; val="${val%\'}" ;;
            esac

            case "$key" in
                runtime)
                    CFG_RUNTIME="$val"
                    ;;
                ports|port)
                    CFG_PORTS="$val"
                    ;;
                network|net)
                    CFG_NETWORK="$val"
                    ;;
                user)
                    CFG_USER="$val"
                    ;;
                selinux)
                    CFG_SELINUX="$val"
                    ;;
                setup|init)
                    CFG_SETUP="$val"
                    ;;
                shell)
                    CFG_SHELL="$val"
                    ;;
                env)
                    CFG_ENVS+=("$val")
                    ;;
            esac
        else
            if [ -z "$CFG_RUNTIME" ]; then
                CFG_RUNTIME="$line"
            fi
        fi
    done < "$config_file"

    if [ -n "$CFG_RUNTIME" ]; then
        CFG_RUNTIME="$(printf '%s' "$CFG_RUNTIME" | tr '[:upper:]' '[:lower:]')"
    fi
    if [ -n "$CFG_SELINUX" ] && [ -z "${AIRLOCK_SELINUX:-}" ]; then
        AIRLOCK_SELINUX="$CFG_SELINUX"
    fi
    if [ -n "$CFG_USER" ] && [ -z "${AIRLOCK_USER:-}" ]; then
        AIRLOCK_USER="$CFG_USER"
    fi
}

is_valid_port() {
    [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Populates the NET_ARGS array (declared by the caller, launch()).
# Never build these as an interpolated string: unquoted expansion of a
# plain string lets a space-containing value smuggle extra flags (e.g.
# network=host --privileged) into the container runtime invocation.
get_network_args() {
    NET_ARGS=()

    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_PORTS" ]; then
            if [ -n "$CFG_NETWORK" ]; then
                warn "⚠ .airlock sets both ports and network; ports take precedence (network ignored)"
            fi
            local p
            for p in $CFG_PORTS; do
                is_valid_port "$p" || { error "Invalid .airlock ports entry: '$p' (expected a number 1-65535)"; exit 1; }
                NET_ARGS+=(-p "$p:$p")
            done
        elif [ -n "$CFG_NETWORK" ]; then
            [[ "$CFG_NETWORK" =~ ^[A-Za-z0-9_.-]+$ ]] || { error "Invalid .airlock network entry: '$CFG_NETWORK' (expected a simple name like host, bridge, none)"; exit 1; }
            NET_ARGS=(--network "$CFG_NETWORK")
        else
            NET_ARGS=(--network host)
        fi
        return
    fi

    local ports
    if ! read -rp "Ports to open (space-separated, e.g. 3000 8080) or Enter for --network host: " ports; then
        dim "(no input detected — using --network host)" >&2
        ports=""
    fi

    if [ -z "$ports" ]; then
        NET_ARGS=(--network host)
    else
        local p
        for p in $ports; do
            is_valid_port "$p" || { error "Invalid port: '$p' (expected a number 1-65535)"; exit 1; }
            NET_ARGS+=(-p "$p:$p")
        done
    fi
}

launch() {
    local name="$1"
    local rt
    rt=$(detect_runtime)
    local -a NET_ARGS
    get_network_args

    local vol_mount="${PWD}:/workspace"
    if is_selinux_enabled; then
        vol_mount="${vol_mount}:z"
    fi

    # Rootless Podman runs as your user, so no UID/GID mapping is needed.
    # AIRLOCK_USER remains as an explicit override.
    local -a user_args=()
    if [ -n "${AIRLOCK_USER:-}" ]; then
        if [ "$AIRLOCK_USER" != "0" ] && [ "$AIRLOCK_USER" != "root" ]; then
            user_args=(--user "$AIRLOCK_USER" -e HOME=/tmp)
        fi
    fi

    local -a image_args
    local default_shell="bash"
    case "$name" in
        alpine)
            image_args=(docker.io/library/alpine:latest)
            default_shell="sh"
            ;;
        archlinux|arch)
            image_args=(docker.io/library/archlinux:latest)
            ;;
        bun)
            image_args=(docker.io/oven/bun:latest)
            ;;
        busybox)
            image_args=(docker.io/library/busybox:latest)
            default_shell="sh"
            ;;
        c|cpp|gcc)
            image_args=(docker.io/library/gcc:latest)
            ;;
        debian)
            image_args=(docker.io/library/debian:stable)
            ;;
        deno)
            image_args=(docker.io/denoland/deno:latest)
            ;;
        fedora)
            image_args=(docker.io/library/fedora:latest)
            ;;
        gitleaks)
            image_args=(docker.io/zricethezav/gitleaks:latest detect --source /workspace -v)
            ;;
        go)
            image_args=(docker.io/library/golang:latest)
            ;;
        grype)
            image_args=(docker.io/anchore/grype:latest /workspace)
            ;;
        hadolint)
            image_args=(docker.io/hadolint/hadolint:latest-alpine)
            default_shell="sh"
            ;;
        kali|kalilinux)
            image_args=(docker.io/kalilinux/kali-rolling:latest)
            ;;
        nix)
            image_args=(docker.io/nixos/nix:latest)
            default_shell="sh"
            ;;
        node)
            image_args=(docker.io/library/node:lts)
            ;;
        nmap)
            image_args=(docker.io/instrumentisto/nmap:latest)
            default_shell="sh"
            ;;
        opencode)
            image_args=(ghcr.io/anomalyco/opencode)
            ;;
        php)
            image_args=(docker.io/library/php:cli)
            ;;
        python)
            image_args=(docker.io/library/python:3)
            ;;
        ruby)
            image_args=(docker.io/library/ruby:latest)
            ;;
        rust)
            image_args=(docker.io/library/rust:latest)
            ;;
        semgrep)
            image_args=(docker.io/semgrep/semgrep:latest semgrep scan)
            ;;
        shellcheck)
            image_args=(docker.io/koalaman/shellcheck-alpine:latest)
            default_shell="sh"
            ;;
        trivy)
            image_args=(docker.io/aquasec/trivy:latest fs /workspace)
            ;;
        ubuntu)
            image_args=(docker.io/library/ubuntu:latest)
            ;;
        zig)
            image_args=(docker.io/euantorano/zig:latest)
            default_shell="sh"
            ;;
        *)
            error "Unknown runtime: $name"
            error "Runtimes: $RUNTIMES_ALL"
            exit 1
            ;;
    esac

    # Handle entrypoints, shells, and optional lifecycle setup command
    case "$name" in
        gitleaks|grype|semgrep|trivy|opencode)
            # Standalone tools/scanners run their default image command
            ;;
        *)
            local shell_to_use="${CFG_SHELL:-$default_shell}"
            if [ -n "$CFG_SETUP" ]; then
                local setup_script
                if [ -n "$CFG_SHELL" ]; then
                    setup_script="$CFG_SETUP && exec $CFG_SHELL"
                else
                    setup_script="$CFG_SETUP && { command -v bash >/dev/null 2>&1 && exec bash || exec sh; }"
                fi

                case "$name" in
                    deno|zig|nmap)
                        local entry_bin="/bin/sh"
                        if [ -n "$CFG_SHELL" ]; then entry_bin="/bin/$CFG_SHELL"; fi
                        image_args=(--entrypoint "$entry_bin" "${image_args[@]}" -c "$setup_script")
                        ;;
                    *)
                        image_args+=("sh" -c "$setup_script")
                        ;;
                esac
            else
                case "$name" in
                    deno|zig|nmap)
                        image_args=(--entrypoint "/bin/$shell_to_use" "${image_args[@]}")
                        ;;
                    *)
                        image_args+=("$shell_to_use")
                        ;;
                esac
            fi
            ;;
    esac

    local -a env_args=()
    if [ "${#CFG_ENVS[@]}" -gt 0 ]; then
        for env_item in "${CFG_ENVS[@]}"; do
            env_args+=(-e "$env_item")
        done
    fi

    printf "%s▸ Launching '%s' sandbox...%s %s(/workspace ↔ %s)%s\n" "$C_DIM" "$name" "$C_RESET" "$C_DIM" "$PWD" "$C_RESET" >&2
    $rt run -it --rm --pids-limit 1024 "${NET_ARGS[@]}" \
        "${user_args[@]}" \
        "${env_args[@]}" \
        -v "$vol_mount" -w /workspace \
        "${image_args[@]}"
}

devbox_basename() {
    B_NAME="airlock-$1"
}

devbox_exists() {
    [ -n "$($rt ps -a --filter "name=^/$B_NAME$" --format '{{.Names}}')" ]
}

devbox_validate_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

# Maps a distro name to its container image (default: Debian).
devbox_image_for_distro() {
    case "${1:-debian}" in
        alpine) echo "docker.io/library/alpine:latest" ;;
        arch|archlinux) echo "docker.io/library/archlinux:latest" ;;
        fedora) echo "docker.io/library/fedora:latest" ;;
        ubuntu) echo "docker.io/library/ubuntu:latest" ;;
        debian|*) echo "docker.io/library/debian:stable" ;;
    esac
}

# Returns the shell available in a devbox image (Alpine has no bash).
devbox_shell_for_image() {
    case "$1" in
        *alpine*) echo "sh" ;;
        *) echo "bash" ;;
    esac
}

# Shell for a devbox's container image (used by devbox_enter).
devbox_shell() {
    devbox_shell_for_image "$($rt inspect --format '{{.Config.Image}}' "$B_NAME")"
}

# Prompts for a box OS (stdout: alpine|archlinux|debian|fedora|ubuntu, prompts: stderr).
# Defaults to debian on empty/invalid input or when stdin is not interactive.
devbox_prompt_distro() {
    local distro
    printf "%sChoose an OS:%s\n" "$C_BOLD" "$C_RESET" >&2
    printf "  %s1)%s Debian (default)\n" "$C_CYAN$C_BOLD" "$C_RESET" >&2
    printf "  %s2)%s Alpine\n" "$C_CYAN$C_BOLD" "$C_RESET" >&2
    printf "  %s3)%s Fedora\n" "$C_CYAN$C_BOLD" "$C_RESET" >&2
    printf "  %s4)%s Ubuntu\n" "$C_CYAN$C_BOLD" "$C_RESET" >&2
    printf "  %s5)%s Arch Linux\n" "$C_CYAN$C_BOLD" "$C_RESET" >&2
    if ! read -rp "Distro [debian] › " distro; then
        dim "(no input detected — using debian)" >&2
        echo "debian"
        return 0
    fi
    case "$distro" in
        ""|1|deb|debian) echo "debian" ;;
        2|al|alpine) echo "alpine" ;;
        3|fed|fedora) echo "fedora" ;;
        4|ub|ubuntu) echo "ubuntu" ;;
        5|arch|archlinux) echo "archlinux" ;;
        *) warn "Invalid distro, using debian."; echo "debian" ;;
    esac
}

devbox_create() {
    local name="$1" distro="${2:-debian}" image shell
    if [ -z "$name" ]; then
        error "Error: box name required (e.g. airlock enter mysandbox)"
        exit 1
    fi
    case "$distro" in
        alpine|arch|archlinux|debian|fedora|ubuntu) ;;
        *)
            error "Error: invalid distro: '$distro' (expected alpine, archlinux, debian, fedora, or ubuntu)"
            exit 1
            ;;
    esac
    if ! devbox_validate_name "$name"; then
        error "Error: invalid box name: '$name'"
        error "Names may contain letters, digits, '_', '.', '-' (no spaces)."
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if devbox_exists; then
        error "Devbox '$name' already exists ($B_NAME)"
        exit 1
    fi
    image=$(devbox_image_for_distro "$distro")
    shell=$(devbox_shell_for_image "$image")
    printf "%s⠋ Creating devbox '%s' [%s]...%s\n" "$C_DIM" "$name" "$distro" "$C_RESET"
    $rt run -d --name "$B_NAME" --network host --pids-limit 1024 \
        "$image" "$shell" -c 'sleep infinity'
    info "✓ Created devbox '$name' ($B_NAME) [$distro]"
}

devbox_enter() {
    local name="$1"
    if [ -z "$name" ]; then
        error "Error: box name required (e.g. airlock enter mysandbox)"
        exit 1
    fi
    if ! devbox_validate_name "$name"; then
        error "Error: invalid box name: '$name'"
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if ! devbox_exists; then
        dim "Box '$name' does not exist yet." >&2
        devbox_create "$name" "$(devbox_prompt_distro)"
    elif [ "$($rt inspect -f '{{.State.Running}}' "$B_NAME")" != "true" ]; then
        $rt start "$B_NAME"
    fi
    $rt exec -it "$B_NAME" "$(devbox_shell)"
}

devbox_list() {
    rt=$(detect_runtime)
    $rt ps -a --filter "name=^/airlock-" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
}

# Prints existing devboxes (if any) before an interactive name prompt, so the
# user can see what's taken/what they can enter or remove.
devbox_show_existing() {
    local rt existing
    rt=$(detect_runtime)
    existing=$($rt ps -a --filter "name=^/airlock-" --format '{{.Names}}')
    if [ -n "$existing" ]; then
        echo "Existing devboxes:"
        $rt ps -a --filter "name=^/airlock-" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
    fi
}

devbox_delete() {
    local name="$1"
    if [ -z "$name" ]; then
        error "Error: box name required (e.g. airlock delete mysandbox)"
        exit 1
    fi
    if ! devbox_validate_name "$name"; then
        error "Error: invalid box name: '$name'"
        exit 1
    fi
    rt=$(detect_runtime)
    devbox_basename "$name"
    if ! devbox_exists; then
        error "Devbox '$name' not found ($B_NAME)"
        exit 1
    fi
    $rt rm -f "$B_NAME"
    info "✓ Removed devbox '$name' ($B_NAME)"
}

menu_devboxes() {
    while true; do
        hdr "◆ Development Boxes"
        printf "  %s1)%s Enter a devbox  %s(creates it if new)%s\n" "$C_CYAN$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
        printf "  %s2)%s List devboxes\n" "$C_CYAN$C_BOLD" "$C_RESET"
        printf "  %s3)%s Delete a devbox\n" "$C_CYAN$C_BOLD" "$C_RESET"
        printf "  %sb)%s Back   %sq)%s Quit\n" "$C_DIM" "$C_RESET" "$C_DIM" "$C_RESET"
        echo
        read -rp "Select option › " choice

        case "$choice" in
            1|e|enter)
                devbox_show_existing
                read -rp "Devbox name › " name
                devbox_enter "$name"
                ;;
            2|l|list|ls) devbox_list ;;
            3|d|delete|rm|remove)
                devbox_show_existing
                read -rp "Devbox name › " name
                devbox_delete "$name"
                ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) error "✘ Invalid option." ;;
        esac
        echo
    done
}

show_header() {
    local rt
    rt=$(detect_runtime)
    printf "\n%s  Airlock %s%s %s%s\n" "$C_BOLD$C_CYAN" "$VERSION" "$C_RESET" "$C_DIM" "· disposable dev sandboxes$C_RESET"
    printf "%s─%s\n" "$C_DIM" "$C_RESET"
    printf "  %sRuntime:%s %s\n" "$C_DIM" "$C_RESET" "$rt"
    if is_selinux_enabled; then
        printf "  %sSELinux:%s %senabled%s %s(:z active)%s\n" "$C_DIM" "$C_RESET" "$C_GREEN" "$C_RESET" "$C_DIM" "$C_RESET"
    fi
    if [ -n "${AIRLOCK_USER:-}" ]; then
        printf "  %sUser:%s    %s\n" "$C_DIM" "$C_RESET" "$AIRLOCK_USER"
    fi
    if [ "$CFG_FOUND" = true ]; then
        if [ -n "$CFG_RUNTIME" ]; then
            printf "  %sConfig:%s  .airlock (runtime: %s%s%s)\n" "$C_DIM" "$C_RESET" "$C_GREEN$C_BOLD" "$CFG_RUNTIME" "$C_RESET"
        else
            printf "  %sConfig:%s  .airlock\n" "$C_DIM" "$C_RESET"
        fi
        if [ -n "$CFG_SETUP" ]; then
            printf "  %sSetup:%s   %s\n" "$C_DIM" "$C_RESET" "$CFG_SETUP"
        fi
    fi
    printf "  %sProject:%s %s\n" "$C_DIM" "$C_RESET" "$PROJECT_URL"
    local latest_version
    latest_version=$(get_latest_version)
    if [ "$latest_version" != "unavailable" ] && version_greater "$latest_version" "$VERSION"; then
        printf "  %sLatest:%s  %s %s(update available)%s\n" "$C_DIM" "$C_RESET" "$latest_version" "$C_YELLOW" "$C_RESET"
        printf "  %sTo update, re-run:%s curl -fsSL https://cdn.jsdelivr.net/gh/besoeasy/airlock@main/install.sh | bash\n" "$C_DIM" "$C_RESET"
    fi
}

