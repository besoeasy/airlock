menu_cleanup() {
    local rt
    rt=$(detect_runtime)
    while true; do
        local reclaim vol_count
        reclaim=$($rt system df 2>/dev/null | awk '/^Images/{print $(NF-1)" "$(NF)}')
        vol_count=$($rt volume ls --filter dangling=true -q 2>/dev/null | wc -l | tr -d ' ')
        [ -n "$reclaim" ] || reclaim="unknown"
        [ -n "$vol_count" ] || vol_count="?"

        hdr "◆ Cleanup — ${reclaim} reclaimable, ${vol_count} volumes"
        printf "%sType a number to delete it, or pick a safe bulk clean.%s\n" "$C_DIM" "$C_RESET"
        echo

        local -a IMGS=()
        # Only images with zero containers (from `system df -v`, which also
        # sees external/stopped containers that `ps -a` misses). Anything
        # in use is hidden so deletion never fails with "image is in use".
        local unused_ids
        unused_ids=$($rt system df -v 2>/dev/null | awk '$NF==0 && $3 ~ /^[0-9a-f]+$/ {print $3}')
        if [ -n "$unused_ids" ]; then
            while IFS= read -r line; do
                [ -n "$line" ] || continue
                lid="${line##*|}"
                if grep -qxF "$lid" <<< "$unused_ids"; then
                    IMGS+=("$line")
                fi
                [ "${#IMGS[@]}" -ge 5 ] && break
            done < <($rt images --sort=size --format "{{.Repository}}:{{.Tag}}|{{.Size}}|{{.ID}}" 2>/dev/null | tac)
        fi
        if [ "${#IMGS[@]}" -eq 0 ]; then
            dim "Nothing unused — every image is in use by a container."
        else
            local i=0 entry name size id short display
            for entry in "${IMGS[@]}"; do
                i=$((i + 1))
                name="${entry%%|*}"; entry="${entry#*|}"
                size="${entry%%|*}"; id="${entry##*|}"
                short="${id:0:12}"
                if [ "$name" = "<none>:<none>" ]; then
                    display="<unused layer>"
                else
                    display="$name"
                fi
                printf "  %s%s)%s %s%-9s%s %s %s(%s)%s\n" "$C_CYAN$C_BOLD" "$i" "$C_RESET" "$C_BOLD" "$size" "$C_RESET" "$display" "$C_DIM" "$short" "$C_RESET"
            done
        fi
        echo
        printf "  %sa)%s Clean all unused images  %s(safe, recommended)%s\n" "$C_GREEN$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
        printf "  %sv)%s Clean unused volumes     %s(deletes data)%s\n" "$C_YELLOW$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
        printf "  %sb)%s Back   %sq)%s Quit\n" "$C_DIM" "$C_RESET" "$C_DIM" "$C_RESET"
        echo
        local choice confirm target_id target_name
        read -rp "Delete # or action › " choice
        case "$choice" in
            1|2|3|4|5)
                if [ "$choice" -gt "${#IMGS[@]}" ]; then error "✘ No such entry."; continue; fi
                entry="${IMGS[$((choice - 1))]}"
                target_name="${entry%%|*}"; entry="${entry#*|}"
                size="${entry%%|*}"; target_id="${entry##*|}"
                [ "$target_name" = "<none>:<none>" ] && target_name="<unused layer> $size"
                read -rp "Remove $target_name ($size)? [y/N] › " confirm
                case "$confirm" in
                    y|Y|yes|YES) $rt rmi "$target_id" && info "✓ Freed $size" || error "✘ Could not remove (in use?)" ;;
                    *) dim "Cancelled." ;;
                esac
                ;;
            a|A|clean|all|prune)
                $rt image prune -f && info "✓ Cleaned unused images" || error "✘ Prune failed"
                ;;
            v|V|vol|volume|volumes)
                read -rp "Delete all unused volumes? Data will be lost. [y/N] › " confirm
                case "$confirm" in
                    y|Y|yes|YES) $rt volume prune -f && info "✓ Cleaned volumes" || error "✘ Prune failed" ;;
                    *) dim "Cancelled." ;;
                esac
                ;;
            b|B|back|BACK) return 0 ;;
            q|Q|exit|"") exit 0 ;;
            *) error "✘ Enter 1-${#IMGS[@]}, a, v, b or q." ;;
        esac
        echo
    done
}

