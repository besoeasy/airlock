completion_usage() {
    echo "Usage: airlock completion <bash|zsh|fish>" >&2
    echo "  Prints a completion script to stdout." >&2
    echo "  Examples:" >&2
    echo "    airlock completion bash >> ~/.bashrc" >&2
    echo "    airlock completion zsh > ~/.zfunc/_airlock" >&2
    echo "    airlock completion fish > ~/.config/fish/completions/airlock.fish" >&2
}

completion_bash() {
    cat <<EOF
# airlock bash completion (generated by \`airlock completion bash\`)
_airlock_completions() {
    local cur prev runtimes
    COMPREPLY=()
    cur="\${COMP_WORDS[COMP_CWORD]}"
    prev="\${COMP_WORDS[COMP_CWORD-1]}"
    runtimes="$RUNTIMES_ALL"
    case "\$prev" in
        airlock)
            COMPREPLY=( \$(compgen -W "\$runtimes enter list delete completion -h --help -v --version" -- "\$cur") )
            ;;
        completion)
            COMPREPLY=( \$(compgen -W "bash zsh fish" -- "\$cur") )
            ;;
    esac
    return 0
}
complete -F _airlock_completions airlock
EOF
}

completion_zsh() {
    cat <<EOF
#compdef airlock
# airlock zsh completion (generated by \`airlock completion zsh\`)
_airlock() {
    local -a runtimes
    runtimes=($RUNTIMES_ALL)
    _arguments -C \\
        '1: :->cmd' \\
        '*: :->args' && return 0
    case \$state in
        cmd)
            _describe 'command' 'runtimes:run a runtime enter:enter-box list:list-boxes delete:delete-box completion:print-completion -h:help --help:help -v:version --version:version' && return 0
            _describe 'runtime' runtimes && return 0
            ;;
        args)
            case \$words[2] in
                completion) _describe 'shell' 'bash:bash zsh:zsh fish:fish' && return 0 ;;
            esac
            ;;
    esac
    return 1
}
compdef _airlock airlock
EOF
}

completion_fish() {
    cat <<EOF
# airlock fish completion (generated by \`airlock completion fish\`)
set -l runtimes $RUNTIMES_ALL
complete -c airlock -f
complete -c airlock -n __fish_use_subcommand -a "$runtimes" -d 'runtime'
complete -c airlock -n __fish_use_subcommand -a enter -d 'enter a persistent box'
complete -c airlock -n __fish_use_subcommand -a list -d 'list persistent boxes'
complete -c airlock -n __fish_use_subcommand -a delete -d 'delete a persistent box'
complete -c airlock -n __fish_use_subcommand -a completion -d 'print completion'
complete -c airlock -n __fish_use_subcommand -s h -l help -d 'show help'
complete -c airlock -n __fish_use_subcommand -s v -l version -d 'show version'
complete -c airlock -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
EOF
}

completion_cmd() {
    case "${1:-}" in
        bash) completion_bash ;;
        zsh) completion_zsh ;;
        fish) completion_fish ;;
        -h|--help|"") completion_usage ;;
        *) echo "Unknown shell: $1 (expected bash, zsh, or fish)" >&2; completion_usage; exit 1 ;;
    esac
}

